---
import TimelinePage from "../components/TimelinePage";
import ThreeCanvas from "../components/ThreeCanvas";
import "../styles/global.css";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Timeline Karir | Abu Riza — Borneo Digital Rimba</title>
    <meta name="description" content="Timeline evolusi karir Abu Riza sejak 2014 — dari SMK hingga IT Staff & Technical Lead di perusahaan teknologi Kalimantan." />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- 3D Background Layer -->
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;">
      <ThreeCanvas client:only="react" />
    </div>

    <!-- Timeline Page -->
    <TimelinePage client:only="react" />
  </body>
</html>
